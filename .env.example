# Optional. Without a key the scene director resolves prompts with the built-in semantic matcher.
# When both keys are set, Gemini is used.
GEMINI_API_KEY=

# Optional. Any Gemini model that supports structured outputs.
GEMINI_MODEL=gemini-3.8-flash

OPENAI_API_KEY=

# Optional. Any OpenAI model that supports structured outputs.
OPENAI_MODEL=gpt-4.1-mini
